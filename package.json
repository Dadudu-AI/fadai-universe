{
  "name": "fadai-universe",
  "version": "1.0.0",
  "description": "Fadai Universe - music-reactive screen visualizer",
  "main": "main.js",
  "author": "Meng Guang",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --arm64"
  },
  "build": {
    "appId": "com.mgmeta.soundorb",
    "productName": "Fadai Universe",
    "asar": false,
    "artifactName": "fadai-universe-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "ball.html",
      "bind.html",
      "lib/**/*",
      "bin/**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Fadai Universe needs microphone access to capture music and drive real-time visualization."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fadai Universe",
      "language": "1033",
      "artifactName": "fadai-universe-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
